# ask CLI 环境变量（复制为 .env 并按需修改；不提交真实密钥）
# 模型（推荐 deepseek-v4.1-flash：实测单轮往返最快、且对 reasoning_effort 敏感）
ASK_MODEL_URL=https://u2a.lycodeing.cn/v1
ASK_MODEL_KEY=sk-your-key-here
ASK_MODEL_NAME=deepseek-v4.1-flash
ASK_MODEL_FAMILY=deepseek

# 设备
ASK_ADB=C:/Users/XiaoFeiLong/AppData/Local/Android/Sdk/platform-tools/adb.exe

# 工作区（运行时产物落点）
# ASK_HOME=C:/opt/scene-kit
# ASK_WORKSPACE=/tmp/my-run
